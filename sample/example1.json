{
  "graph": {
    "title": "PING - eSystem - External User & Employee - Accessing Flow",
    "filename": "output/eSystem",
    "outformat": "png",
    "direction": "LR",
    "show": false,
    "curvestyle": "curved",
    "graph_attr": {
      "pad": "0.6",
      "splines": "spline",
      "nodesep": "0.5",
      "ranksep": "0.75",
      "fontsize": "14"
    },
    "node_attr": {
      "fontsize": "11"
    },
    "edge_attr": {
      "fontsize": "10"
    }
  },

  "defaults": {
    "edge_attributes": {
      "color": "#424242"
    }
  },

  "nodes": [
    {
      "id": "users",
      "label": "Employees",
      "node_class": "diagrams.onprem.client.User"
    },
    {
      "id": "external_agents",
      "label": "CA/GA",
      "node_class": "diagrams.onprem.client.Users"
    },

    {
      "id": "apache_rp",
      "label": "Reverse Proxy",
      "node_class": "diagrams.onprem.network.Apache"
    },

    {
      "id": "sharedhub_appgw",
      "label": "Azure App G/W",
      "node_class": "diagrams.azure.network.ApplicationGateway"
    },

    {
      "id": "ping_access",
      "label": "PING Access",
      "node_class": "diagrams.onprem.compute.Server"
    },
    {
      "id": "ping_federate",
      "label": "PING Federate",
      "node_class": "diagrams.onprem.compute.Server"
    },
    {
      "id": "ping_directory",
      "label": "PING Directory",
      "node_class": "diagrams.onprem.compute.Server"
    },

    {
      "id": "azure_fw",
      "label": "Azure Firewall \n (Next Hop)",
      "node_class": "diagrams.azure.network.Firewall"
    },
    {
      "id": "appgw_ext",
      "label": "Azure App G/W",
      "node_class": "diagrams.azure.network.ApplicationGateway"
    },

    {
      "id": "aks_eSystem",
      "label": "AKS: eSystem 2.0",
      "node_class": "diagrams.azure.compute.KubernetesServices"
    },
    {
      "id": "aks_navi",
      "label": "AKS: navi",
      "node_class": "diagrams.azure.compute.KubernetesServices"
    },

    {
      "id": "azure_entra",
      "label": "Azure Entra",
      "node_class": "diagrams.azure.identity.ActiveDirectory"
    },
    {
      "id": "apim",
      "label": "API Management",
      "node_class": "diagrams.azure.integration.APIManagement"
    },
    {
      "id": "master4_db",
      "label": "Master4 DB",
      "node_class": "diagrams.onprem.database.Oracle"
    },
    {
      "id": "akamai",
      "label": "Akamai",
      "node_class": "diagrams.saas.cdn.Akamai"
    }
  ],

  "clusters": [
    {
      "name": "Internet",
      "graph_attr": {
        "style": "rounded,filled",
        "bgcolor": "#C3D5E5",
        "color": "#C3D5E5",
        "penwidth": "2",
        "margin": "16"
      },
      "node_ids": ["users"]
    },

    {
      "name": "Intranet",
      "graph_attr": {
        "style": "rounded,filled",
        "bgcolor": "#C3D5E5",
        "color": "#C3D5E5",
        "penwidth": "2",
        "margin": "16"
      },
      "node_ids": ["external_agents"]
    },

    {
      "name": "Akamai",
      "graph_attr": {
        "style": "rounded,filled",
        "bgcolor": "#C3D5E5",
        "color": "#C3D5E5",
        "penwidth": "2",
        "margin": "16"
      },
      "node_ids": ["akamai"]
    },

    {
      "name": "Azure Cloud - Japan East",
      "graph_attr": {
        "style": "rounded,filled",
        "bgcolor": "#C3D5E5",
        "color": "#C3D5E5",
        "penwidth": "2",
        "margin": "16"
      },
      "node_ids": ["azure_entra"],
      "clusters": [
        {
          "name": "Japan Shared Hub Service",
          "graph_attr": {
            "style": "rounded,filled",
            "bgcolor": "#C3D5E5",
            "color": "#C3D5E5",
            "penwidth": "2",
            "margin": "16"
          },
          "node_ids": ["sharedhub_appgw", "azure_fw"],
          "clusters": [
            {
              "name": "PING",
              "graph_attr": {
                "style": "rounded,filled",
                "bgcolor": "#C3D5E5",
                "color": "#4DC0A9",
                "penwidth": "2",
                "margin": "14"
              },
              "node_ids": ["ping_access", "ping_federate", "ping_directory"]
            }
          ]
        },

        {
          "name": "Spoke Network",
          "graph_attr": {
            "style": "rounded,filled",
            "bgcolor": "#C3D5E5",
            "color": "#C3D5E5",
            "penwidth": "2",
            "margin": "16"
          },
          "node_ids": ["appgw_ext", "apim"],
          "clusters": [
            {
              "name": "AKS",
              "graph_attr": {
                "style": "rounded,filled",
                "bgcolor": "#C3D5E5",
                "color": "#C3D5E5",
                "penwidth": "2",
                "margin": "14"
              },
              "node_ids": ["aks_eSystem", "aks_navi"]
            }
          ]
        }
      ]
    },

    {
      "name": "On-premise",
      "clusters": [
        {
          "name": "DMZ",
          "graph_attr": {
            "style": "rounded,filled",
            "bgcolor": "#C3D5E5",
            "color": "#C3D5E5",
            "penwidth": "2",
            "margin": "16"
          },
          "node_ids": ["apache_rp"]
        },
        {
          "name": "App Secured",
          "graph_attr": {
            "style": "rounded,filled",
            "bgcolor": "#C3D5E5",
            "color": "#C3D5E5",
            "penwidth": "2",
            "margin": "16"
          },
          "node_ids": ["master4_db"]
        }
      ]
    }
  ],

  "edges": [
    {
      "from": "users",
      "to": "akamai",
      "attributes": { "label": "1. Internet Access", "color": "#1565C0" }
    },
    {
      "from": "akamai",
      "to": "sharedhub_appgw",
      "attributes": { "label": "1. Internet Access", "color": "#1565C0" }
    },
    {
      "from": "external_agents",
      "to": "apache_rp",
      "attributes": { "label": "1. External Agents access", "color": "#6A1B9A" }
    },
    {
      "from": "apache_rp",
      "to": "akamai",
      "attributes": { "label": "1. External Agents access", "color": "#6A1B9A" }
    },

    {
      "from": "akamai",
      "to": "sharedhub_appgw",
      "attributes": {
        "label": "1.1 External Agents access",
        "color": "#6A1B9A"
      }
    },
    {
      "from": "sharedhub_appgw",
      "to": "ping_access",
      "attributes": {
        "label": "Ping Access"
      }
    },

    {
      "from": "ping_access",
      "to": "ping_federate",
      "attributes": { "label": "2. Return PF cookie", "color": "#2E7D32" }
    },
    {
      "from": "ping_access",
      "to": "appgw_ext",
      "attributes": { "label": "1.6 Access eSystem", "color": "#0D0D0D" }
    },

    {
      "from": "ping_federate",
      "to": "azure_entra",
      "attributes": {
        "label": "1.3 for Employees (Entra/IdP)",
        "style": "dashed",
        "color": "#00838F"
      }
    },
    {
      "from": "ping_federate",
      "to": "ping_directory",
      "attributes": {
        "label": "Authentication",
        "style": "dashed",
        "color": "#00838F"
      }
    },

    {
      "from": "ping_federate",
      "to": "appgw_ext",
      "attributes": {
        "label": "1.5 API for Authentication",
        "color": "#5E35B1"
      }
    },
    {
      "from": "appgw_ext",
      "to": "aks_navi",
      "attributes": {
        "label": "1.5 API for Authentication",
        "color": "#5E35B1"
      }
    },

    {
      "from": "aks_navi",
      "to": "apim",
      "attributes": {
        "label": "1.5 API for Authentication",
        "color": "#5E35B1"
      }
    },
    {
      "from": "apim",
      "to": "ping_federate",
      "attributes": {
        "label": "1.5 API for Authentication",
        "color": "#5E35B1"
      }
    },

    {
      "from": "appgw_ext",
      "to": "aks_eSystem",
      "attributes": {
        "label": "5. Access eSystem Directly",
        "color": "#FB8C00"
      }
    },

    {
      "from": "ping_federate",
      "to": "master4_db",
      "attributes": {
        "label": "1.4 Authorization (DB Connectivity)",
        "color": "#1976D2"
      }
    }
  ]
}
